<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SHOUT_PUBLIC_RELAY_HOST Condition="'$(SHOUT_PUBLIC_RELAY_HOST)' == ''">$(PLOGON_SECRET_public_relay_host)</SHOUT_PUBLIC_RELAY_HOST>
  </PropertyGroup>
  <Import Project="../../PublicRelay.local.props" Condition="'$(SHOUT_PUBLIC_RELAY_HOST)' == '' and Exists('../../PublicRelay.local.props')" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ShoutCalendar.Core</RootNamespace>
    <AssemblyName>ShoutCalendar.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup Condition="'$(SHOUT_PUBLIC_RELAY_HOST)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PublicRelayHost</_Parameter1>
      <_Parameter2>$(SHOUT_PUBLIC_RELAY_HOST)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
