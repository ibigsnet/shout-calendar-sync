# Copy to an untracked .env and replace all example values before deployment.
RELAY_IMAGE=registry.example/operator/shout-calendar-relay@sha256:REPLACE_WITH_REVIEWED_IMAGE_DIGEST
RELAY_DATA=/srv/shout-calendar-relay/data
RELAY_ADMIN_TOKEN_FILE=/srv/shout-calendar-relay/secrets/admin-token
RELAY_IP=192.0.2.10
RELAY_TRUSTED_PROXY=192.0.2.20
RELAY_NETWORK=relay-private
# Supply these separately to the Caddy process environment.
RELAY_PUBLIC_HOST=relay.example
RELAY_UPSTREAM=192.0.2.10:8787
